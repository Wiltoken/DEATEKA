# Base de datos SQLite. La ruta es relativa a prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Secreto para firmar las sesiones de autenticación.
# Generá uno nuevo con: openssl rand -base64 32
AUTH_SECRET=""

# Habilitar el throttle por IP del login SOLO detrás de un reverse proxy
# confiable (que sobrescriba x-forwarded-for). Sin proxy, dejarlo en "false".
TRUST_PROXY="false"

# Credenciales del admin de demostración (usadas por el seed).
# Cambialas en producción. Si no se definen, se usan los valores demo.
# ADMIN_EMAIL="admin@deateka.com"
# ADMIN_PASSWORD="generá-una-contraseña-fuerte"
